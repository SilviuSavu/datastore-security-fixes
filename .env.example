# Data Backfill API Keys
# Copy this file to .env and fill in your actual API keys

# EODHD API Key
EODHD_API_KEY=your_eodhd_api_key_here

# Polygon API Key
POLYGON_API_KEY=your_polygon_api_key_here

# Databento API Key
DATABENTO_API_KEY=your_databento_api_key_here

# Interactive Brokers API Key (if applicable)
IBKR_API_KEY=your_ibkr_api_key_here

# Yahoo Finance (free tier, no key required but you can set up premium if needed)
YFINANCE_PREMIUM_KEY=your_yfinance_premium_key_here

# Backfill Configuration
BACKFILL_BATCH_SIZE=50
BACKFILL_MAX_CONCURRENT_REQUESTS=10
BACKFILL_RETRY_ATTEMPTS=3
BACKFILL_TIMEOUT_SECONDS=30

# Logging Configuration
BACKFILL_LOG_LEVEL=INFO
BACKFILL_LOG_FILE=backfill_operations.log

# FINRA API Keys
FINRA_CLIENT_ID=your_finra_client_id_here
FINRA_CLIENT_PASSWORD=your_finra_client_password_here

# FRED API Key
FRED_API_KEY=your_fred_api_key_here
